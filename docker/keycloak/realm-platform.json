{
  "realm": "platform",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [{ "name": "PLATFORM_ADMIN" }, { "name": "TENANT_ADMIN" }]
  },
  "users": [
    {
      "username": "kcadmin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Keycloak",
      "lastName": "Admin",
      "attributes": {
        "tenant_code": ["acme"],
        "platform_user_id": ["1001"]
      },
      "credentials": [
        { "type": "password", "value": "admin123", "temporary": false }
      ],
      "realmRoles": ["TENANT_ADMIN"]
    }
  ],
  "clients": [
    {
      "clientId": "platform-api",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "tenant_code",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "tenant_code",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "tenant_code",
            "jsonType.label": "String"
          }
        },
        {
          "name": "platform_user_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "platform_user_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "platform_user_id",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ]
}
